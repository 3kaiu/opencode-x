// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode mcp --help 1`] = `
"opencode mcp

manage MCP (Model Context Protocol) servers

命令：
  opencode mcp add [name]     add an MCP server
  opencode mcp list           list MCP servers and their status                        [aliases: ls]
  opencode mcp auth [name]    authenticate with an OAuth-enabled MCP server
  opencode mcp logout [name]  remove OAuth credentials for an MCP server
  opencode mcp debug <name>   debug OAuth connection for an MCP server

选项：
  -h, --help        show help                                                                 [布尔]
  -v, --version     show version number                                                       [布尔]
      --print-logs  print logs to stderr                                                      [布尔]
      --log-level   log level                    [字符串] [可选值: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                              [布尔]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode attach --help 1`] = `
"opencode attach <url>

attach to a running opencode server

位置：
  url  http://localhost:4096                                                         [字符串] [必需]

选项：
  -h, --help          show help                                                               [布尔]
  -v, --version       show version number                                                     [布尔]
      --print-logs    print logs to stderr                                                    [布尔]
      --log-level     log level                  [字符串] [可选值: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                            [布尔]
      --dir           directory to run in                                                   [字符串]
  -c, --continue      continue the last session                                               [布尔]
  -s, --session       session id to continue                                                [字符串]
      --fork          fork the session when continuing (use with --continue or --session)     [布尔]
  -p, --password      basic auth password (defaults to OPENCODE_SERVER_PASSWORD)            [字符串]
  -u, --username      basic auth username (defaults to OPENCODE_SERVER_USERNAME or 'opencode')
                                                                                            [字符串]
      --mini          start the minimal interactive interface                 [布尔] [默认值: false]
      --no-replay     disable mini session history replay on resume and after resize          [布尔]
      --replay-limit  cap visible mini replay to the newest N messages                        [数字]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode run --help 1`] = `
"opencode run [message..]

run opencode with a message

位置：
  message  message to send                                                       [数组] [默认值: []]

选项：
  -h, --help         show help                                                                [布尔]
  -v, --version      show version number                                                      [布尔]
      --print-logs   print logs to stderr                                                     [布尔]
      --log-level    log level                   [字符串] [可选值: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                             [布尔]
      --command      the command to run, use message for args                               [字符串]
  -c, --continue     continue the last session                                                [布尔]
  -s, --session      session id to continue                                                 [字符串]
      --fork         fork the session before continuing (requires --continue or --session)    [布尔]
  -m, --model        model to use in the format of provider/model                           [字符串]
      --agent        agent to use                                                           [字符串]
      --format       format: default (formatted) or json (raw JSON events)
                                            [字符串] [可选值: "default", "json"] [默认值: "default"]
  -f, --file         file(s) to attach to message                                             [数组]
      --title        title for the session (uses truncated prompt if no value provided)     [字符串]
      --attach       attach to a running opencode server (e.g., http://localhost:4096)      [字符串]
  -p, --password     basic auth password (defaults to OPENCODE_SERVER_PASSWORD)             [字符串]
  -u, --username     basic auth username (defaults to OPENCODE_SERVER_USERNAME or 'opencode')
                                                                                            [字符串]
      --dir          directory to run in, path on remote server if attaching                [字符串]
      --port         port for the local server (defaults to random port if no value provided) [数字]
      --variant      model variant (provider-specific reasoning effort, e.g., high, max, minimal)
                                                                                            [字符串]
      --thinking     show thinking blocks                                                     [布尔]
  -i, --interactive  run in direct interactive split-footer mode              [布尔] [默认值: false]
      --auto         auto-approve permissions that are not explicitly denied (dangerous!)
                                                                              [布尔] [默认值: false]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode debug --help 1`] = `
"opencode debug

debugging and troubleshooting tools

命令：
  opencode debug config        show resolved configuration
  opencode debug lsp           LSP debugging utilities
  opencode debug rg            ripgrep debugging utilities
  opencode debug file          file system debugging utilities
  opencode debug scrap         list all known projects
  opencode debug skill         list all available skills
  opencode debug snapshot      snapshot debugging utilities
  opencode debug startup       print startup timing
  opencode debug agent <name>  show agent configuration details
  opencode debug v2            debug v2 catalog and built-in plugins
  opencode debug info          show debug information
  opencode debug paths         show global paths (data, config, cache, state)
  opencode debug wait          wait indefinitely (for debugging)

选项：
  -h, --help        show help                                                                 [布尔]
  -v, --version     show version number                                                       [布尔]
      --print-logs  print logs to stderr                                                      [布尔]
      --log-level   log level                    [字符串] [可选值: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                              [布尔]"
`;

